{
  "name": "driving-school-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "review": "npx tsx --env-file=.env.local tools/code-review/review.ts",
    "review:ci": "npx tsx tools/code-review/review.ts",
    "review:working": "git diff | npx tsx --env-file=.env.local tools/code-review/review.ts",
    "review:staged": "git diff --staged | npx tsx --env-file=.env.local tools/code-review/review.ts",
    "review:head": "git diff HEAD~1 | npx tsx --env-file=.env.local tools/code-review/review.ts",
    "review:branch": "git diff main...HEAD | npx tsx --env-file=.env.local tools/code-review/review.ts",
    "eval": "node --env-file=.env.local node_modules/.bin/promptfoo eval --config tools/code-review/evals/promptfooconfig.yaml",
    "eval:ci": "promptfoo eval --config tools/code-review/evals/promptfooconfig.yaml"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@base-ui/react": "^1.6.0",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "ai": "^7.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "resend": "^6.17.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "promptfoo": "^0.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^54.7.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
